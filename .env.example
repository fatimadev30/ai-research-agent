# Supabase (PostgreSQL) — pre-configured in this environment
SUPABASE_URL=your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# TinyFish (required for web search/fetch)
# Get an API key at https://docs.tinyfish.ai/
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://api.tinyfish.ai

# Google Sheets export (optional)
# Path to a Google service-account JSON key file
GOOGLE_CLIENT_SECRETS_PATH=

# Operational limits
MAX_TARGET_RECORDS=500
DEFAULT_BATCH_SIZE=20
DEFAULT_CONCURRENCY=3
REQUEST_TIMEOUT=30
MAX_RETRIES=3
TEMP_DIR=/tmp/research_agent
